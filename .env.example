# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Database (Postgres — run via `docker compose up -d`)
DATABASE_URL=postgresql://inbox:inbox@localhost:5432/inbox_to_action

# Google OAuth (needed once Gmail integration is wired up — leave unset until then)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Single MVP test user (Decision 5: no UTC fallback — timezone must be explicit)
USER_TIMEZONE=Asia/Karachi

# Notion
NOTION_API_KEY=
NOTION_DATABASE_ID=

# V2.7 — automatic Gmail poll interval, in seconds. Defaults to 120 (2 min).
# Safe to lower for a live demo (e.g. 15) so autonomous monitoring visibly
# fires without a long wait — the failure-backoff floor stays fixed at 10
# minutes regardless (app/scheduler.py), so this never weakens that
# fail-safe. Remember to unset or restore this before/after demoing.
GMAIL_POLL_INTERVAL_SECONDS=15
