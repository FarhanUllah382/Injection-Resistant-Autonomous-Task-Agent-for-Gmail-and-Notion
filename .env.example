# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Database (Postgres — run via `docker compose up -d`)
DATABASE_URL=postgresql://inbox:inbox@localhost:5432/inbox_to_action

# Google OAuth (needed once Gmail integration is wired up — leave unset until then)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Single MVP test user (Decision 5: no UTC fallback — timezone must be explicit)
USER_TIMEZONE=Asia/Karachi

# Notion
NOTION_API_KEY=
NOTION_DATABASE_ID=
